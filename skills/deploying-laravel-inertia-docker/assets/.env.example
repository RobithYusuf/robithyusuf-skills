# Template variabel untuk Docker. Gabungkan ke .env.example proyek, jangan menimpa.
# Nilai rahasia (APP_KEY, DB_PASSWORD, DB_ROOT_PASSWORD, API key) diisi di .env lokal
# atau di panel environment platform deploy, tidak pernah di-commit.

# --- Identitas deploy (dipakai docker-compose untuk nama container & routing Traefik) ---
APP_SLUG=app
APP_DOMAIN=app.example.com

# --- Aplikasi ---
APP_NAME="My App"
APP_ENV=production
# Isi dengan output: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
APP_LOCALE=en

# --- Database (DB_HOST = nama service di compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
# Wajib, password acak yang kuat
DB_PASSWORD=
# Wajib, hanya dipakai container MySQL
DB_ROOT_PASSWORD=
# Set false hanya untuk Docker dev bila muncul error self-signed certificate
MYSQL_ATTR_SSL_VERIFY=true

# --- Cache, session, queue ---
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Seeder & SSR ---
# true hanya untuk deploy pertama, lalu kembalikan ke false
RUN_SEEDERS=false
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# --- API pihak ketiga ---
# Tambahkan nama variabelnya di sini (nilai kosong), isi nilainya di panel deploy.
