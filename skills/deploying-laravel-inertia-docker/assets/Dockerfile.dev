# Development image: source code di-mount sebagai volume, aset di-serve Vite dev server (HMR).
# Tidak ada npm ci / npm run build / composer install di sini: dependency di-install entrypoint-dev.sh
# karena volume mount menimpa isi image.
FROM php:8.2-fpm-alpine

RUN apk add --no-cache \
    nginx supervisor curl zip unzip git \
    icu-dev libzip-dev libpng-dev libjpeg-turbo-dev \
    freetype-dev oniguruma-dev sqlite-dev \
    mysql-client shadow nodejs npm
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install pdo pdo_mysql pdo_sqlite \
    mbstring zip bcmath opcache intl gd pcntl exif
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html

# Sengaja tanpa opcache.ini: validate_timestamps=0 akan membuat perubahan PHP tidak terdeteksi.
COPY docker/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/nginx-dev.conf /etc/nginx/http.d/default.conf
COPY docker/supervisord-dev.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/entrypoint-dev.sh /usr/local/bin/entrypoint.sh

RUN mkdir -p /var/log/supervisor && chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80 5173
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
